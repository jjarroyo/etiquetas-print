{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "etiquetas-print",
    "version": "1.0.0",
    "identifier": "com.etiquetas.print",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "etiquetas-print",
                "width": 1200,
                "height": 800,
                "decorations": true,
                "transparent": true,
                "backgroundColor": "#f8fafc",
                "visible": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
