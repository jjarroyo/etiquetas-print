{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "opener:default",
        "sql:default",
        "sql:allow-load",
        "sql:allow-execute",
        "sql:allow-select",
        "fs:default",
        "dialog:default",
        "fs:allow-download-write",
        "fs:allow-desktop-write",
        "fs:allow-document-write",
